# ---------------------------------------------------------------------------
# PrimeStone backend environment
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# NEVER commit real values. .env* is gitignored.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, RDS…).
# For Neon/Supabase use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Salt used to hash ID numbers for de-duplication. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_HASH_SALT="change-me-to-a-long-random-string"

# --- KYC document storage (Vercel Blob) ------------------------------------
# Create a Blob store in the Vercel dashboard; it provides this token.
BLOB_READ_WRITE_TOKEN=""

# --- M-Pesa (Safaricom Daraja) ---------------------------------------------
# Start with the SANDBOX values; switch to production after go-live approval.
MPESA_ENVIRONMENT="sandbox"          # "sandbox" | "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"             # sandbox paybill
MPESA_PASSKEY=""                     # Lipa na M-Pesa Online passkey
MPESA_CALLBACK_URL="https://your-domain.com/api/payments/mpesa/callback"
# Transaction type: "CustomerPayBillOnline" (Pay Bill, default) or
# "CustomerBuyGoodsOnline" if the shortcode is a Buy Goods / Till number.
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# ONLY set this if Safaricom says STK is registered under a Head Office number
# that differs from the paybill/till the customer pays. Then:
#   MPESA_SHORTCODE   = the Head Office number that signs the STK request
#   MPESA_PARTY_B     = the paybill/till number the money actually goes to
# Leave blank for a normal shortcode (PartyB defaults to MPESA_SHORTCODE).
MPESA_PARTY_B=""

# --- Email (Resend) — welcome email + password reset -----------------------
# Sign up at resend.com (free), create an API key, verify your sending domain.
RESEND_API_KEY=""
# Verified sender. Use onboarding@resend.dev to TEST (only reaches your own
# Resend account email) until your domain is verified.
EMAIL_FROM="PrimeStone <noreply@primestonemarkets.com>"
# Public site origin used in email links (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://primestonemarkets.com"

# --- Admin console ---------------------------------------------------------
ADMIN_PASSWORD=""                    # required to log into /admin (no default)
# Optional Cloudflare Turnstile ("verify you are human") on admin login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Crypto deposits (NOWPayments) -----------------------------------------
# Sign up at nowpayments.io, set your payout wallet (USDT TRC-20 recommended),
# then: Store Settings → API key, and Payments → IPN → generate the IPN secret.
# Set the IPN callback to https://primestonemarkets.com/api/payments/crypto/callback
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# --- Copy-trade engine -----------------------------------------------------
# Settlement mode for the automated copy engine:
#   "paper" (default) — positions open, mark live, and record P&L, but NOTHING
#            touches real balances. Safe to run before you're ready.
#   "live"  — closes post real ledger transactions; real client money moves.
COPY_SETTLEMENT="paper"
# Secret protecting the engine's cron endpoint (/api/cron/copy-tick). Vercel
# Cron sends it automatically as a Bearer token. Generate a random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
# Real market data for non-crypto instruments (forex, metals, indices).
# Crypto is always live with NO key. Add a Twelve Data key to enable the rest.
#   Sign up free at twelvedata.com → API key.
MARKET_DATA_API_KEY=""
